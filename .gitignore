# Ignore documentation with potential license issues
参考/

# Common ignores
node_modules/
dist/
!apps/postgres/ui/assets/
!apps/postgres/ui/assets/**
config/*
!config/.gitkeep
target/
.DS_Store
/*.log

# Driver UI binaries (layout only tracked)
driver-ui/**/*.exe
driver-ui/**/*.dll
driver-ui/**/*.pdb
src-tauri/driver-ui/**/*.exe
src-tauri/driver-ui/**/*.dll
src-tauri/driver-ui/**/*.pdb

# build.rs が apps/common/ui-assets/ から同期するビルド成果物
apps/joywatcher/ui/assets/_shared/
apps/postgres/ui/assets/_shared/