# Ignore documentation with potential license issues
参考/

# Common ignores
node_modules/
dist/
!drivers/postgres/ui/assets/
!drivers/postgres/ui/assets/**
ops/config/*
!ops/config/.gitkeep
target/
.DS_Store
/*.log

# Driver UI binaries (layout only tracked)
ops/driver-ui/**/*.exe
ops/driver-ui/**/*.dll
ops/driver-ui/**/*.pdb
core/src-tauri/driver-ui/**/*.exe
core/src-tauri/driver-ui/**/*.dll
core/src-tauri/driver-ui/**/*.pdb

# build.rs が apps/common/ui-assets/ から同期するビルド成果物
drivers/joywatcher/ui/assets/_shared/
drivers/postgres/ui/assets/_shared/