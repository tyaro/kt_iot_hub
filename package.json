{
  "name": "kt_iot_hub",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tauri": "tauri --config ./core/src-tauri/tauri.conf.json",
    "tauri-dev": "tauri dev --config ./core/src-tauri/tauri.conf.json",
    "tauri-build": "tauri build --config ./core/src-tauri/tauri.conf.json",
    "driver-runtime:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/install-driver-runtime.ps1",
    "driver-runtime:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/build-dev-driver-runtime.ps1",
    "driver-ui:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/install-driver-ui.ps1",
    "driver-ui:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/build-dev-driver-ui.ps1",
    "driver-suite:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/build-release-driver-suite.ps1",
    "joywatcher-ui:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/build-dev-joywatcher-ui.ps1",
    "joywatcher-suite:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/build-dev-joywatcher-suite.ps1",
    "joywatcher-ui:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/launch-dev-joywatcher-ui.ps1",
    "tauri-build:bundle-drivers": "npm run driver-suite:release && npm run tauri-build",
    "release:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/build-release-all-and-clean.ps1",
    "cleanup:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ops/scripts/cleanup-debug-workspace.ps1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/cli": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "overrides": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0-next.6"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.1.0"
  }
}
